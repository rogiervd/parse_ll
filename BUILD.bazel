load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "parse_ll",
    # Headers that a user of this library can include.
    hdrs = ["include/parse_ll/core.hpp"] + glob([
        "include/parse_ll/core/*.hpp",
        "include/parse_ll/core/outcome/*.hpp",
        "include/parse_ll/core/detail/*.hpp",
        "include/parse_ll/number/*.hpp",
        "include/parse_ll/support/*.hpp",
        "include/parse_ll/debug/*.hpp",
    ]),
    # Allow each header to be compiled on its own, to check that it includes
    # everything it needs, by passing Bazel --process_headers_in_dependencies.
    features = ["parse_headers"],
    # The prefix to be added to the include path.
    # If the include directory can be set to "include", then include_prefix
    # should be set to "".
    include_prefix = "",
    # The prefix to be stripped from the include path.
    strip_include_prefix = "include/",
    visibility = ["//visibility:public"],
    # Dependencies of this library.
    deps = [
        "@boost.exception",
        "@boost.mpl",
        "@boost.optional",
        "@boost.spirit",
        "@boost.utility",
        "@boost.variant",
        "@meta",
        "@range",
        "@rime",
        "@utility",
    ],
)
