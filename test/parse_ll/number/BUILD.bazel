load("@rules_cc//cc:defs.bzl", "cc_test")

[
    cc_test(
        name = test_name[:-4],
        size = "small",
        srcs = [test_name],
        deps = [
            "//:parse_ll",
            "//test/parse_ll/helper",
            "@boost.math",
            "@boost.test//:unit_test_main",
        ],
    )
    for test_name in glob(["*.cpp"])
]
